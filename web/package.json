    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^26.1.0",
    "msw": "^2.11.3",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
