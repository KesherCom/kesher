# kesher Docker configuration.
#
#   cp deploy/compose/.env.example deploy/compose/.env
#
# docker compose picks up deploy/compose/.env automatically for every
# docker-compose.*.yml in this folder. Never commit the real .env.

# ── Required for LAN clients ───────────────────────────────────────────────
# LAN IP of the Docker host (the address clients use to reach it). It is
# advertised to browsers (WebRTC) and the desktop app (native UDP audio).
# Leave at 127.0.0.1 only when testing on this one PC.
KESHER_PUBLIC_IP=127.0.0.1

# Admin PIN for the "Show admin" area. Change it!
ADMIN_PIN=123456

# ── Ports (host side) ──────────────────────────────────────────────────────
# docker-compose.yml
KESHER_HTTP_PORT=8080
# docker-compose.selfsigned.yml
KESHER_HTTPS_PORT=8443
# UDP ports are published 1:1 (host = container) and must be reachable from
# clients (firewall!).
# browser audio (WebRTC)
KESHER_WEBRTC_UDP_PORT=8082
# desktop app low-latency audio
KESHER_NATIVE_UDP_PORT=8081

SESSION_TTL_MINUTES=720
# KESHER_VERSION=1.2.3         # version string baked into the image

# ── Self-signed HTTPS (docker-compose.selfsigned.yml) ──────────────────────
# The certificate covers localhost + KESHER_PUBLIC_IP. Add more names here:
# CERT_EXTRA_SAN=DNS:intercom.local,IP:10.0.0.5
# CERT_DAYS=825

# ── Trusted HTTPS via CertMagic (docker-compose.certmagic.yml) ─────────────
CERTMAGIC_DOMAINS=intercom.example.org
CERTMAGIC_EMAIL=ops@example.org
CERTMAGIC_DNS_PROVIDER=cloudflare
# CERTMAGIC_CA=https://acme-staging-v02.api.letsencrypt.org/directory   # for trial runs
# CERTMAGIC_PROPAGATION_DELAY_SECONDS=0
# CERTMAGIC_PROPAGATION_TIMEOUT_SECONDS=120
# CERTMAGIC_DNS_RESOLVERS=1.1.1.1:53,8.8.8.8:53

# Cloudflare (API token with Zone:DNS:Edit, not the global API key)
CERTMAGIC_CLOUDFLARE_API_TOKEN=
# CERTMAGIC_CLOUDFLARE_ZONE_TOKEN=

# Hetzner
# CERTMAGIC_DNS_PROVIDER=hetzner
# CERTMAGIC_HETZNER_API_TOKEN=

# Route53
# CERTMAGIC_DNS_PROVIDER=route53
# CERTMAGIC_ROUTE53_REGION=eu-central-1
# CERTMAGIC_ROUTE53_ACCESS_KEY_ID=
# CERTMAGIC_ROUTE53_SECRET_ACCESS_KEY=
# CERTMAGIC_ROUTE53_HOSTED_ZONE_ID=
