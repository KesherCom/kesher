# Slim kesher instance image for the netlab test lab (make nettest).
# The lab exercises REST + WebSocket + WebRTC only, so the web frontend
# build is skipped for fast iteration. Network emulation (delay/loss/
# jitter) runs in-process, gated by NETLAB_* env vars (emu_net.go).
FROM golang:1.25-alpine AS build
ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG VERSION=netlab
ARG BUILD_TIMESTAMP=unknown
WORKDIR /src/backend
COPY backend/go.mod backend/go.sum* ./
RUN go mod download
COPY backend/ .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w -X github.com/KesherCom/kesher/backend/internal/app.Version=$VERSION -X github.com/KesherCom/kesher/backend/internal/app.BuildTimestamp=$BUILD_TIMESTAMP" -o /out/server ./cmd/server

FROM alpine:3.21
RUN mkdir -p /app/data
COPY --from=build /out/server /app/server
EXPOSE 8080
CMD ["/app/server"]
