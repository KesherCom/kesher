# Kesher server settings. Copy to .env next to docker-compose.yml:
#
#   cp .env.example .env
#
# After changes: docker compose up -d

# Nothing here has to be changed.

# Admin PIN. Leave empty: the first visit in the browser asks for it. If set
# here, it replaces the PIN on every start.
ADMIN_PIN=

# Image version: "latest" or a fixed release such as 0.9.0 (recommended for
# events: updates only happen when you change this line).
KESHER_VERSION=latest

# Ports on the server. Open them in the firewall.
# TCP: web UI and API for browsers (https://<server-ip>:8443)
KESHER_HTTPS_PORT=8443
# TCP: plain HTTP for the desktop app and Pi stations (http://<server-ip>:8080)
KESHER_HTTP_PORT=8080
# UDP: audio of the desktop app and the Pi stations
KESHER_NATIVE_UDP_PORT=8081
# UDP: audio of browsers
KESHER_WEBRTC_UDP_PORT=8082

# Only if the server has several networks (e.g. LAN + management) and clients
# must use one specific address: that address. Otherwise leave empty.
KESHER_PUBLIC_IP=

# Extra names for the HTTPS certificate, e.g. a local DNS name:
# CERT_EXTRA_SAN=DNS:intercom.local
# Login lifetime in minutes.
# SESSION_TTL_MINUTES=720
