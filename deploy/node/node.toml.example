# kesher-node configuration: /etc/kesher/node.toml
#
# Nothing has to be set here. With this file unchanged the station:
#   1. finds the Kesher server on the network by itself,
#   2. appears in the admin area under "Stations",
#   3. starts working as soon as an admin approves it there (name, role and
#      talk mode are chosen in the admin area).
#
# After editing:  sudo systemctl restart kesher-node
# Check it:       sudo kesher-node check
# Logs:           journalctl -u kesher-node -f
# Full guide:     docs/hardware/raspberry-pi.md

# Server address. Only needed if the server is in another network (the
# automatic search only works within one network):
# server = "https://192.168.1.10:8443"

# Log in directly with a role instead of approving the station in the admin
# area. Then name and mode are set here, too:
# role = "stage"
# name = "stage-left"          # default: the Pi's hostname
# mode = "ptt"                 # "ptt" or "always_on"
# takeover = false             # true: take the role even if someone uses it

# Accept any HTTPS certificate. Normally not needed: a self-signed server
# certificate is remembered on first contact and checked from then on.
# tls_insecure = false

[audio]
# Sound card: part of its name as shown by `kesher-node devices`, e.g. "USB"
# or the headset brand. Leave out for the system default.
input = "USB"
output = "USB"
# Mic gain in dB (-40 .. +24).
# input_gain_db = 0.0
# Noise gate in dBFS (-72 .. -12); leave out to disable.
# gate_db = -52.0

# Party lines (room IDs from the admin area). Leave out to use the role's
# default party line.
# [rooms]
# listen = ["foh", "stage"]
# talk = ["stage"]

# Talk button and LED on the Pi header, by GPIO number (BCM), not pin
# number: GPIO17 = physical pin 11, GPIO27 = pin 13, GND = pin 9 or 14.
# Button: between the GPIO and GND. LED: GPIO -> 330 ohm -> LED -> GND.
# LED: on = talking, slow blink = no server, double blink = waiting for
# approval in the admin area.
# [gpio]
# talk_button = 17
# talk_led = 27
