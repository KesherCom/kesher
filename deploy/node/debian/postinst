#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
  # Service account with access to sound cards and (on a Pi) GPIO.
  if ! getent passwd kesher-node >/dev/null; then
    adduser --system --group --no-create-home --home /var/lib/kesher-node kesher-node >/dev/null
  fi
  for group in audio gpio; do
    if getent group "$group" >/dev/null; then
      adduser kesher-node "$group" >/dev/null 2>&1 || true
    fi
  done
  chown root:kesher-node /etc/kesher/node.toml
  chmod 0640 /etc/kesher/node.toml

  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    systemctl enable kesher-node.service >/dev/null 2>&1 || true
    # Works without editing the config: the station finds the server on
    # the network and waits for approval in the admin area.
    systemctl restart kesher-node.service || true
    echo "kesher-node: started. Approve this station in the Kesher admin area -> Stations."
  fi
fi

exit 0
